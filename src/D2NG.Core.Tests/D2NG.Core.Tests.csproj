<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D2NG.Core\D2NG.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The item tables live with the run configs now; the tests keep their own copy so they do not
         depend on a folder outside the repository. -->
    <None Update="data\item_data.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="data\item_properties.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Sales captured on the realm and the price table rows their items use, for ItemPriceTests. -->
    <None Update="data\item-prices.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="data\item-sales.jsonl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Game server packets from recorded games, none that carries a name, for PacketParserDifferentialTests. -->
    <None Update="data\packet-corpus.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
